{
  "name": "gramsetu-server",
  "version": "1.0.0",
  "description": "Express REST API backend for GramSetu (VGMP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/api.test.js",
    "test:live": "cmd /c \"set RUN_LIVE_DB_TESTS=1 && node --test tests/live.test.js\"",
    "hash-passwords": "node scripts/hashPasswords.js",
    "generate-hash": "node scripts/generateHash.js",
    "migrate-legacy": "node scripts/migrateLegacyComplaints.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemon": "^3.1.14"
  }
}
